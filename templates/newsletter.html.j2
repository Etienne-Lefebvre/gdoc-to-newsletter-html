<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>[[ meta_title ]]</title>
  <style type="text/css">
    *, *:after, *:before { box-sizing: border-box; }
    * { -ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; }
    html, body { width: 100% !important; margin: 0; padding: 0; }
    body { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; padding: 0; border-collapse: collapse; }
    img { -ms-interpolation-mode: bicubic; max-width: 100%; border: 0; outline: none; text-decoration: none; display: block; }
    body, html, td { font-family: "Helvetica Neue", Helvetica, Arial, Verdana, sans-serif; color: #0c2340; }
    a, .container a { color: #623a00; text-decoration: underline; }
    span > a { color: inherit !important; }
    @media screen and (max-width: 600px) {
      .container { width: 100% !important; max-width: 100% !important; }
      .stack { display: block !important; width: 100% !important; max-width: 100% !important; }
      .eo-button { width: 100% !important; text-align: center; margin: auto !important; }
      .eo-button td, .eo-button tr { display: block !important; }
      .h1-mobile { font-size: 32px !important; line-height: 36px !important; }
    }
  </style>
</head>

<body style="margin:0; padding:0; background-color:#ffe6c1; color:#0c2340; font-family:'Helvetica Neue', Helvetica, Arial, Verdana, sans-serif; font-size:17px;">

  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">
    [[ preheader ]]
  </div>

  [#-- ===========================================================
       MACROS
       =========================================================== #]

  [%- macro render_runs(html) -%]
  [[ html ]]
  [%- endmacro -%]

  [%- macro section_banner(name) -%]
  <tr>
    <td style="padding:25px 10px 10px 10px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#0c2340" style="background-color:#0c2340;">
        <tr><td style="padding:7px 0 0 0;">
          <table align="center" cellpadding="0" cellspacing="0" style="width:50%; border-bottom:4px solid rgb(255,181,73);"><tr><td>&nbsp;</td></tr></table>
        </td></tr>
        <tr><td align="center" style="padding:10px 0;">
          <h1 style="margin:0; font-size:30px; line-height:1.1; color:#ffffff; font-weight:bold; text-align:center;">[[ escape(name) ]]</h1>
        </td></tr>
        <tr><td style="padding:0 0 7px 0;">
          <table align="center" cellpadding="0" cellspacing="0" style="width:50%; border-top:4px solid rgb(255,181,73);"><tr><td>&nbsp;</td></tr></table>
        </td></tr>
      </table>
    </td>
  </tr>
  [%- endmacro -%]

  [#-- A single yellow button. --#]
  [%- macro button(label, url, width_pct=70) -%]
  <table cellpadding="0" cellspacing="0" align="center" class="eo-button" bgcolor="rgb(255,181,73)" style="border-radius:8px; background-color:rgb(255,181,73); width:[[ width_pct ]]%; margin:0 auto;">
    <tr><td align="center" valign="middle">
      <a href="[[ escape_attr(url) ]]" target="_blank" style="display:block; padding:18px; font-size:18px; font-weight:bold; line-height:100%; text-align:center; text-decoration:none; color:#0c2340;">[[ escape(label) ]]</a>
    </td></tr>
  </table>
  [%- endmacro -%]

  [#-- A row of 1/2/3 buttons (auto-picks layout from the buttons list). --#]
  [%- macro button_row(buttons) -%]
  [%- if buttons|length == 0 -%]
  [%- elif buttons|length == 1 -%]
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr><td align="center" valign="top" style="padding:10px 0 25px 0;">
        [[ button(buttons[0].label, buttons[0].url, 70) ]]
      </td></tr>
    </table>
  [%- else -%]
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:10px;">
      <tr>
        [%- for btn in buttons -%]
        <td width="[[ (100 // (buttons|length)) ]]%" class="stack" valign="top" style="padding:10px 5px 25px 5px;">
          <table align="center" cellpadding="0" cellspacing="0" class="eo-button" width="100%" bgcolor="rgb(255,181,73)" style="border-radius:8px; background-color:rgb(255,181,73);">
            <tr><td align="center" valign="middle">
              <a href="[[ escape_attr(btn.url) ]]" target="_blank" style="display:block; padding:18px; font-size:18px; font-weight:bold; line-height:100%; text-align:center; text-decoration:none; color:#0c2340;">[[ escape(btn.label) ]]</a>
            </td></tr>
          </table>
        </td>
        [%- endfor -%]
      </tr>
    </table>
  [%- endif -%]
  [%- endmacro -%]

  [#-- An image with optional clickable wrap. max_w in px. --#]
  [%- macro image(src, max_w, link=None, alt='') -%]
  [%- if link -%]
    <a href="[[ escape_attr(link) ]]" target="_blank">
      <img src="[[ escape_attr(src) ]]" alt="[[ escape_attr(alt) ]]" width="[[ max_w ]]" style="display:block; width:100%; max-width:[[ max_w ]]px; height:auto; margin:0 auto;">
    </a>
  [%- else -%]
    <img src="[[ escape_attr(src) ]]" alt="[[ escape_attr(alt) ]]" width="[[ max_w ]]" style="display:block; width:100%; max-width:[[ max_w ]]px; height:auto; margin:0 auto;">
  [%- endif -%]
  [%- endmacro -%]

  [#-- Square-fit image for events: constrains BOTH width and height so tall
       book covers and wide landscape shots both fit a ~340x340 box. Outlook
       desktop ignores max-height (its only fix is pre-resizing the source). --#]
  [%- macro event_image(src, link=None, alt='') -%]
  [%- if link -%]
    <a href="[[ escape_attr(link) ]]" target="_blank">
      <img src="[[ escape_attr(src) ]]" alt="[[ escape_attr(alt) ]]" width="340" style="display:block; width:auto; height:auto; max-width:340px; max-height:340px; margin:0 auto;">
    </a>
  [%- else -%]
    <img src="[[ escape_attr(src) ]]" alt="[[ escape_attr(alt) ]]" width="340" style="display:block; width:auto; height:auto; max-width:340px; max-height:340px; margin:0 auto;">
  [%- endif -%]
  [%- endmacro -%]

  [#-- HIGHLIGHT (or SPOTLIGHT) — full-width content card with optional image,
       optional caption, body, and N buttons. --#]
  [%- macro highlight_full(b) -%]
  <tr>
    <td style="padding:0 10px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        [%- if b.fields.get('Title') %]
        <tr><td style="padding:10px 5px 15px 5px;">
          <h2 style="margin:0; text-align:center; font-size:24px; line-height:1.25; font-weight:bold; color:#0c2340;">[[ escape(b.fields['Title']) ]]</h2>
        </td></tr>
        [%- endif %]
        [%- if b.fields.get('Image') %]
        <tr><td align="center" style="padding:5px;">
          [[ image(b.fields['Image'], 680, b.fields.get('Image Link')) ]]
        </td></tr>
        [%- endif %]
        [%- if b.fields.get('Caption') %]
        <tr><td style="padding:0 5px;">
          <p style="margin:0; text-align:right; font-size:12px; line-height:1; color:#0c2340;"><em>[[ escape(b.fields['Caption']) ]]</em></p>
        </td></tr>
        [%- endif %]
        [%- if b.body_html %]
        <tr><td style="padding:10px 5px;">
          <div style="font-size:17px; line-height:1.25; color:#0c2340;">
            [[ b.body_html ]]
          </div>
        </td></tr>
        [%- endif %]
        [%- if b.buttons %]
        <tr><td style="padding:0 5px;">
          [[ button_row(b.buttons) ]]
        </td></tr>
        [%- endif %]
      </table>
    </td>
  </tr>
  [%- endmacro -%]

  [#-- HIGHLIGHT contents only (no outer <tr>) for use inside a 2-col row. --#]
  [%- macro highlight_inner(b) -%]
  [%- if b.fields.get('Title') %]
  <h2 style="margin:0; padding:5px 10px; text-align:center; font-size:20px; line-height:1.1; font-weight:bold; color:#0c2340;">[[ escape(b.fields['Title']) ]]</h2>
  [%- endif %]
  [%- if b.fields.get('Image') %]
  <div style="padding:5px 10px; text-align:center;">
    [[ image(b.fields['Image'], 340, b.fields.get('Image Link')) ]]
  </div>
  [%- endif %]
  [%- if b.body_html %]
  <div style="padding:5px 10px; font-size:17px; line-height:1.25; color:#0c2340;">
    [[ b.body_html ]]
  </div>
  [%- endif %]
  [%- if b.buttons %]
  <div style="padding:5px 10px;">
    [[ button_row(b.buttons) ]]
  </div>
  [%- endif %]
  [%- endmacro -%]

  [#-- EVENT — half-width (50/50 text+image) or full --#]
  [%- macro event_half_inner(b) -%]
  [%- if b.fields.get('Title') %]
  <h2 style="margin:0; padding:5px 10px; font-size:20px; line-height:1.1; font-weight:bold; color:#0c2340;">[[ escape(b.fields['Title']) ]]</h2>
  [%- endif %]
  <div style="padding:5px 10px; font-size:17px; line-height:1.25; color:#0c2340;">
    [%- if b.fields.get('Date') %]<div><strong>Date:</strong> [[ escape(b.fields['Date']) ]]</div>[% endif %]
    [%- if b.fields.get('Location') %]<div><strong>Location:</strong> [[ escape(b.fields['Location']) ]]</div>[% endif %]
    [%- if b.body_html %]<br>[[ b.body_html ]][% endif %]
  </div>
  [%- if b.buttons %]
  <div style="padding:5px 10px 15px 10px;">
    <table cellpadding="0" cellspacing="0" align="left" class="eo-button" bgcolor="rgb(255,181,73)" style="border-radius:8px; background-color:rgb(255,181,73); width:70%;">
      <tr><td align="center" valign="middle">
        <a href="[[ escape_attr(b.buttons[0].url) ]]" target="_blank" style="display:block; padding:18px; font-size:18px; font-weight:bold; line-height:100%; text-align:center; text-decoration:none; color:#0c2340;">[[ escape(b.buttons[0].label) ]]</a>
      </td></tr>
    </table>
  </div>
  [%- endif %]
  [%- endmacro -%]

  [%- macro event_pair_row(left, right) -%]
  <tr>
    <td style="padding:10px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td width="50%" class="stack" valign="top" style="padding-bottom:25px;">
            [[ event_half_inner(left) ]]
          </td>
          <td width="50%" class="stack" valign="top" align="center" style="padding:5px 10px 25px 10px;">
            [%- if left.fields.get('Image') %]
              [[ event_image(left.fields['Image'], left.buttons[0].url if left.buttons else None) ]]
            [%- endif %]
          </td>
        </tr>
      </table>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td width="50%" class="stack" valign="top">
            [[ event_half_inner(right) ]]
          </td>
          <td width="50%" class="stack" valign="top" align="center" style="padding:5px 10px;">
            [%- if right.fields.get('Image') %]
              [[ event_image(right.fields['Image'], right.buttons[0].url if right.buttons else None) ]]
            [%- endif %]
          </td>
        </tr>
      </table>
    </td>
  </tr>
  [%- endmacro -%]

  [%- macro event_single(b) -%]
  <tr>
    <td style="padding:10px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td width="50%" class="stack" valign="top">
            [[ event_half_inner(b) ]]
          </td>
          <td width="50%" class="stack" valign="top" align="center" style="padding:5px 10px;">
            [%- if b.fields.get('Image') %]
              [[ event_image(b.fields['Image'], b.buttons[0].url if b.buttons else None) ]]
            [%- endif %]
          </td>
        </tr>
      </table>
    </td>
  </tr>
  [%- endmacro -%]

  [#-- RECAP — half (50/50 with image above text) or full (image full width) --#]
  [%- macro recap_half_inner(b) -%]
  [%- if b.fields.get('Title') %]
  <h2 style="margin:0; padding:10px 5px; font-size:24px; line-height:1.1; font-weight:bold; color:#0c2340;">[[ escape(b.fields['Title']) ]]</h2>
  [%- endif %]
  [%- if b.fields.get('Image') %]
  <div style="text-align:center; padding:5px;">
    [[ image(b.fields['Image'], 340) ]]
  </div>
  [%- endif %]
  [%- if b.body_html %]
  <div style="padding:10px 5px; font-size:17px; line-height:1.25; color:#0c2340;">
    [[ b.body_html ]]
  </div>
  [%- endif %]
  [%- endmacro -%]

  [%- macro recap_pair_row(left, right) -%]
  <tr>
    <td style="padding:10px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td width="50%" class="stack" valign="top">[[ recap_half_inner(left) ]]</td>
          <td width="50%" class="stack" valign="top">[[ recap_half_inner(right) ]]</td>
        </tr>
      </table>
    </td>
  </tr>
  [%- endmacro -%]

  [%- macro recap_full(b) -%]
  <tr>
    <td style="padding:10px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        [%- if b.fields.get('Title') %]
        <tr><td style="padding:10px 5px;">
          <h2 style="margin:0; font-size:24px; line-height:1.1; font-weight:bold; color:#0c2340; text-align:center;">[[ escape(b.fields['Title']) ]]</h2>
        </td></tr>
        [%- endif %]
        [%- if b.fields.get('Image') %]
        <tr><td align="center" style="padding:5px;">
          [[ image(b.fields['Image'], 680) ]]
        </td></tr>
        [%- endif %]
        [%- if b.body_html %]
        <tr><td style="padding:10px 5px;">
          <div style="font-size:17px; line-height:1.25; color:#0c2340;">[[ b.body_html ]]</div>
        </td></tr>
        [%- endif %]
      </table>
    </td>
  </tr>
  [%- endmacro -%]

  [#-- NEWS / CITY-HALL: body is a list (already rendered as HTML) --#]
  [%- macro news_block(b) -%]
  <tr>
    <td style="padding:0 5px 10px 5px;">
      <div style="font-size:17px; line-height:1.5; color:#0c2340;">
        [[ b.body_html ]]
      </div>
    </td>
  </tr>
  [%- endmacro -%]

  [%- macro city_hall_block(b) -%]
  <tr>
    <td style="padding:10px 5px;">
      <div style="font-size:17px; line-height:1.25; color:#0c2340;">
        [[ b.body_html ]]
      </div>
    </td>
  </tr>
  [%- endmacro -%]

  [#-- LEAD: italic intro paragraph(s) --#]
  [%- macro lead_block(b) -%]
  <tr>
    <td style="padding:10px;">
      <div style="font-size:17px; line-height:1.25; color:#0c2340; font-style:italic;">
        [[ b.body_html ]]
      </div>
    </td>
  </tr>
  [%- endmacro -%]

  [#-- IMAGE-ONLY: centered standalone image --#]
  [%- macro image_only(b) -%]
  <tr>
    <td align="center" style="padding:5px;">
      [%- if b.fields.get('Image') %]
        [[ image(b.fields['Image'], 489, b.fields.get('Image Link')) ]]
      [%- endif %]
    </td>
  </tr>
  [%- endmacro -%]

  [#-- Dispatcher: render any block in single (full-width) mode --#]
  [%- macro render_single(b) -%]
  [%- if b.type == 'SECTION' -%]
    [[ section_banner(b.fields.get('Name', '')) ]]
  [%- elif b.type == 'LEAD' -%]
    [[ lead_block(b) ]]
  [%- elif b.type == 'HIGHLIGHT' or b.type == 'SPOTLIGHT' -%]
    [[ highlight_full(b) ]]
  [%- elif b.type == 'EVENT' -%]
    [[ event_single(b) ]]
  [%- elif b.type == 'RECAP' -%]
    [[ recap_full(b) ]]
  [%- elif b.type == 'NEWS' -%]
    [[ news_block(b) ]]
  [%- elif b.type == 'CITY-HALL' -%]
    [[ city_hall_block(b) ]]
  [%- elif b.type == 'IMAGE-ONLY' -%]
    [[ image_only(b) ]]
  [%- endif -%]
  [%- endmacro -%]

  [#-- Dispatcher: render a pair of half-width blocks side-by-side --#]
  [%- macro render_pair(left, right) -%]
  [%- if left.type == 'EVENT' and right.type == 'EVENT' -%]
    [[ event_pair_row(left, right) ]]
  [%- elif left.type == 'RECAP' and right.type == 'RECAP' -%]
    [[ recap_pair_row(left, right) ]]
  [%- else -%]
    [#-- Generic half-pair: render each in its own column using highlight_inner --#]
    <tr>
      <td style="padding:10px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
          <tr>
            <td width="50%" class="stack" valign="top">[[ highlight_inner(left) ]]</td>
            <td width="50%" class="stack" valign="top">[[ highlight_inner(right) ]]</td>
          </tr>
        </table>
      </td>
    </tr>
  [%- endif -%]
  [%- endmacro -%]

  [#-- ===========================================================
       PAGE
       =========================================================== #]

  <table role="presentation" align="center" width="100%" cellpadding="0" cellspacing="0" style="background-color:#ffe6c1;">
    <tr>
      <td valign="top" align="center">
        <table role="presentation" class="container" align="center" cellpadding="0" cellspacing="0" width="700" style="width:700px; max-width:700px; background-color:#ffe6c1;">

          [#-- HEADER --#]
          <tr>
            <td style="padding:10px 10px 0 10px;">
              <p style="margin:0; padding:5px; text-align:center; font-size:12px; color:#0c2340;">
                <a href="{{WebVersionURL}}" style="color:#623a00; text-decoration:underline;">View this email in your browser</a>
              </p>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:10px;">
              <a href="https://strongtownsottawa.ca/">
                <img src="https://gallery.eomail5.com/8b591ef0-3332-11f0-90c2-e97e10baf656%2F1751560054307-StrongTowns-Ottawa_Icon_Yellow-Navy_Original.png" alt="Strong Towns Ottawa logo" width="197" style="width:197px; max-width:29%; display:block;">
              </a>
            </td>
          </tr>
          <tr>
            <td style="padding:0 10px 10px 10px;">
              <h1 class="h1-mobile" style="margin:0; padding:0; text-align:center; font-size:48px; line-height:1.1; font-weight:bold; color:#0c2340;">
                [[ meta_title ]]
              </h1>
            </td>
          </tr>

          [#-- BLOCKS --#]
          [% for row in rows %]
            [%- if row.kind == 'single' -%]
              [[ render_single(row.block) ]]
            [%- else -%]
              [[ render_pair(row.left, row.right) ]]
            [%- endif -%]
          [% endfor %]

          [#-- FOOTER --#]
          <tr>
            <td style="padding:10px 10px 0 10px;">
              <hr style="border:0; border-top:1px solid #ffd9a0; margin:10px 0;">
            </td>
          </tr>
          <tr>
            <td align="center" valign="top" style="padding:5px 10px;">
              <table align="center" cellpadding="0" cellspacing="0" role="presentation">
                <tr>
                  <td align="center" valign="middle" width="48" style="padding:0 5px;">
                    <a href="https://discord.gg/kHaVNgrcsG" target="_blank"><img src="https://gallery.eomail5.com/tentacles/icons/v1/social-block/square/color/discord.png" width="48" height="48" alt="Discord" style="display:block; border:0; width:48px; height:auto;"></a>
                  </td>
                  <td align="center" valign="middle" width="48" style="padding:0 5px;">
                    <a href="https://bsky.app/profile/strongtownsottawa.ca" target="_blank"><img src="https://gallery.eomail5.com/tentacles/icons/v1/social-block/square/color/bluesky.png" width="48" height="48" alt="Bluesky" style="display:block; border:0; width:48px; height:auto;"></a>
                  </td>
                  <td align="center" valign="middle" width="48" style="padding:0 5px;">
                    <a href="https://www.facebook.com/groups/strongtownsott/" target="_blank"><img src="https://gallery.eomail5.com/tentacles/icons/v1/social-block/square/color/facebook.png" width="48" height="48" alt="Facebook" style="display:block; border:0; width:48px; height:auto;"></a>
                  </td>
                  <td align="center" valign="middle" width="48" style="padding:0 5px;">
                    <a href="https://www.instagram.com/strongtownsottawa/" target="_blank"><img src="https://gallery.eomail5.com/tentacles/icons/v1/social-block/square/color/instagram.png" width="48" height="48" alt="Instagram" style="display:block; border:0; width:48px; height:auto;"></a>
                  </td>
                  <td align="center" valign="middle" width="48" style="padding:0 5px;">
                    <a href="https://linktr.ee/strongtownsottawa" target="_blank"><img src="https://gallery.eomail5.com/tentacles/icons/v1/social-block/square/color/website.png" width="48" height="48" alt="Website" style="display:block; border:0; width:48px; height:auto;"></a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:10px;">
              <div style="font-size:11px; line-height:1.25; text-align:center; color:#0c2340;">
                <br>
                {{SenderInfo}}
                <br><br>
                You received this email because you subscribed to our list. You can
                <a href="{{UnsubscribeURL}}" style="color:#313638;">unsubscribe</a> at any time.
              </div>
            </td>
          </tr>
          <tr>
            <td style="padding:10px;" align="center">
              <p style="margin:0; font-size:11px; line-height:1.25; text-align:center; color:#0c2340;">
                <a href="{{RewardsURL}}" style="color:#623a00; text-decoration:underline;">Powered by EmailOctopus</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
